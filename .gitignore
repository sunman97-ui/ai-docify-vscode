# --- Dependencies ---
# Never commit node_modules. It is huge and re-downloadable.
node_modules/

# --- Build Output ---
# Standard TypeScript output folder
out/
# Webpack bundle output (Crucial since you are using webpack)
dist/

# --- Testing ---
# The test runner downloads a local copy of VS Code here.
.vscode-test/

# --- Packaging ---
# The final extension file generated by 'vsce package'
*.vsix

# --- Logs & Junk ---
*.log
npm-debug.log
yarn-error.log
.DS_Store
Thumbs.db

# --- Security (Just in case) ---
.env

# --- Gemini ---
*GEMINI.md
