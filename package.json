{
"name": "ai-docify-vscode",
  "displayName": "AI Docify",
  "publisher": "sunman97-ui",    
  "description": "AI Documentation Generator",
  "icon": "icon.png",
  "version": "0.1.2",
  "author": {
    "name": "John Spencer",
    "email": "johnspencer97@live.co.uk"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunman97-ui/ai-docify-vscode"
  },
  "engines": {
  "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "AI Docify",
      "properties": {
        "aiDocify.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to the python executable where ai-docify is installed."
        },
        "aiDocify.provider": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "ollama"],
          "description": "Default AI provider."
        },
        "aiDocify.model": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "Default model name (must match pricing.json)."
        }
      }
    },
    "commands": [
      {
        "command": "ai-docify.documentFile",
        "title": "AI Docify: Document Current File"
      },
      {
        "command": "ai-docify.stripDocs",
        "title": "AI Docify: Strip Docstrings (Undo)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ai-docify.documentFile",
          "group": "1_modification",
          "when": "resourceLangId == python"
        },
        {
          "command": "ai-docify.stripDocs",
          "group": "1_modification",
          "when": "resourceLangId == python"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "ts-loader": "^9.5.1",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}